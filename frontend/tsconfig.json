{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2022", "DOM"],
    "strict": true,
    "skipLibCheck": true,
    "noEmitOnError": true,
    "outDir": "./dist",
    "types": ["vitest/globals", "node"]
  },
  "include": ["./**/*.ts"]
}
