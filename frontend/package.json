{
  "name": "koko-frontend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  },
  "scripts": {
    "test": "vitest run --exclude dist/**",
    "test:e2e": "vitest run --exclude dist/** tests/端到端测试.spec.ts",
    "typecheck": "tsc --noEmit",
    "typecheck:watch": "tsc --noEmit --watch --preserveWatchOutput",
    "build": "pnpm typecheck && node build.mjs",
    "dev:watch": "node build.mjs --watch",
    "dev:watch:supervised": "node build.mjs --watch=forever"
  },
  "dependencies": {
    "@chenglou/pretext": "0.0.5",
    "@tanstack/lit-virtual": "^3.13.24",
    "@uppy/core": "^5.2.0",
    "@uppy/tus": "^5.1.1",
    "heic2any": "^0.0.4",
    "idb": "^8.0.3",
    "lit": "^3.3.2",
    "photoswipe": "^5.4.4",
    "socket.io-client": "^4.8.3",
    "vidstack": "^0.6.15",
    "webtorrent": "^2.8.5",
    "workbox-core": "^7.4.0",
    "workbox-precaching": "^7.4.0",
    "xstate": "^5.30.0"
  },
  "devDependencies": {
    "@types/node": "^25.5.2",
    "bittorrent-tracker": "^11.2.2",
    "esbuild": "^0.28.0",
    "happy-dom": "^20.8.9",
    "typescript": "^6.0.2",
    "vitest": "^4.1.3",
    "workbox-build": "^7.4.0"
  }
}
