{
  "name": "koko-frontend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.33.0",
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "node-datachannel"
    ]
  },
  "scripts": {
    "test": "vitest run --exclude dist/**",
    "test:integration-smoke": "vitest run --exclude dist/** tests/前后台壳集成冒烟测试.spec.ts",
    "check:test-architecture": "node ../scripts/check-test-architecture-fitness.mjs --enforce",
    "check:browser-app-constitution": "node ../scripts/check-frontend-browser-app-constitution.mjs",
    "check:architecture-fitness": "node ../scripts/check-frontend-architecture-fitness.mjs",
    "typecheck": "tsc --noEmit",
    "typecheck:watch": "tsc --noEmit --watch --preserveWatchOutput",
    "build": "pnpm check:browser-app-constitution && pnpm check:architecture-fitness && pnpm check:test-architecture && pnpm typecheck && node build.mjs",
    "dev:watch": "node build.mjs --watch",
    "dev:watch:supervised": "node build.mjs --watch=forever"
  },
  "dependencies": {
    "@chenglou/pretext": "0.0.5",
    "@tanstack/lit-virtual": "^3.13.24",
    "@uppy/core": "^5.2.0",
    "@uppy/tus": "^5.1.1",
    "debug": "^4.4.3",
    "events": "^3.3.0",
    "hash-wasm": "4.12.0",
    "heic2any": "^0.0.4",
    "idb": "^8.0.3",
    "lit": "^3.3.2",
    "mediabunny": "1.40.1",
    "photoswipe": "^5.4.4",
    "socket.io-client": "^4.8.3",
    "webtorrent": "^2.8.5",
    "workbox-core": "^7.4.0",
    "workbox-precaching": "^7.4.0",
    "workbox-routing": "^7.4.0",
    "workbox-strategies": "7.4.0",
    "xstate": "^5.30.0"
  },
  "devDependencies": {
    "@types/node": "^25.5.2",
    "bittorrent-tracker": "^11.2.2",
    "esbuild": "^0.28.0",
    "fake-indexeddb": "^6.2.5",
    "happy-dom": "^20.8.9",
    "typescript": "^6.0.2",
    "vitest": "^4.1.3",
    "workbox-build": "^7.4.0"
  }
}
