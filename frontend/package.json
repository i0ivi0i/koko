{
  "name": "koko-frontend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  },
  "scripts": {
    "test": "vitest run --exclude dist/**",
    "test:e2e": "vitest run --exclude dist/** tests/端到端测试.spec.ts",
    "typecheck": "tsc --noEmit",
    "typecheck:watch": "tsc --noEmit --watch --preserveWatchOutput",
    "build": "pnpm typecheck && esbuild 入口.ts --bundle --outfile=dist/app.js --format=esm --platform=browser --target=es2022 --sourcemap",
    "dev:watch": "esbuild 入口.ts --bundle --outfile=dist/app.js --format=esm --platform=browser --target=es2022 --sourcemap --watch",
    "dev:watch:supervised": "esbuild 入口.ts --bundle --outfile=dist/app.js --format=esm --platform=browser --target=es2022 --sourcemap --watch=forever"
  },
  "dependencies": {
    "lit": "^3.3.2",
    "socket.io-client": "^4.8.3"
  },
  "devDependencies": {
    "@types/node": "^25.5.2",
    "esbuild": "^0.28.0",
    "happy-dom": "^20.8.9",
    "typescript": "^6.0.2",
    "vitest": "^4.1.2"
  }
}
