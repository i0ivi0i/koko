target/
target-spec-review/
dist/

# This is an application/server repo, not a reusable library crate.
# Keep the lockfile tracked so builds stay reproducible across Win11 and Linux.
!Cargo.lock

# Tests are source code and must stay under version control.
!tests/

# Editor-local workflow files should stay local, not in the shared repo.
.cursor/
.vscode/
.kiro/
.serena/

# Keep real SQLx metadata when it exists, but do not track an empty placeholder.
.sqlx/.gitkeep
.env
frontend/node_modules/
frontend/.tsbuildinfo

# Common local OS noise.
Thumbs.db
.DS_Store
__pycache__/
*.pyc

# Local study clones stay outside this repo's version history.
学习/Telegram-iOS/
学习/pretext/

# Local runtime data stays out of version control.
/data/
tmp/
.tmp/
.tmp-run-*.log
/artifacts/smoke/

# Local trash directory for pre-upgrade backups and salvage.
.trash/

# Local implementation plans are working notes and should not participate in version control.
/docs/superpowers/plans/

# Local Codex runtime noise
.codex-*.log
.codex-*.pid
.codex/smoke-launch/

# Local Playwright crash/runtime folders should remain untracked.
/.playwright-cli/
/.tmp-playwright-crash/
