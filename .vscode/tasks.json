{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "koko dev",
      "type": "shell",
      "command": "powershell",
      "args": [
        "-ExecutionPolicy",
        "Bypass",
        "-File",
        "${workspaceFolder}\\run.ps1",
        "-DatabaseUrl",
        "postgres://postgres:postgres@127.0.0.1:5432/postgres",
        "-NoBrowser",
        "$true"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "presentation": {
        "reveal": "always",
        "panel": "dedicated",
        "focus": true
      },
      "problemMatcher": []
    },
    {
      "label": "cargo check (isolated)",
      "type": "shell",
      "command": "cargo check --target-dir target/check"
    },
    {
      "label": "cargo nextest (isolated)",
      "type": "shell",
      "command": "cargo nextest run --target-dir target/nextest"
    },
    {
      "label": "cargo test --doc (isolated)",
      "type": "shell",
      "command": "cargo test --doc --target-dir target/doctest"
    },
    {
      "label": "cargo build --timings (isolated)",
      "type": "shell",
      "command": "cargo build --timings --target-dir target/timings"
    }
  ]
}
