{
  "db_name": "PostgreSQL",
  "query": "\n                SELECT id, room_id, sender_id, content, created_at\n                FROM messages\n                WHERE room_id = $1\n                  AND (\n                      created_at < $2\n                      OR (created_at = $2 AND id < $3)\n                  )\n                ORDER BY created_at DESC, id DESC\n                LIMIT $4\n                ",
