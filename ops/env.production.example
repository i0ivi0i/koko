# 正式公网入口。Caddy 只认这一套域名，不允许再长第二入口。
KOKO_DOMAIN=example.com

# Postgres 容器自己的初始化参数。
POSTGRES_DB=koko
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change-me

# Rust 后端连接数据库时必须直接连 Compose 内部服务名 `postgres`，
# 不要再写 127.0.0.1，避免容器内外各说各话。
DATABASE_URL=postgres://postgres:change-me@postgres:5432/koko
ADMIN_PASSWORD=change-me
RUST_LOG=info
APP_PORT=8080

# 浏览器公开 contract 永远收口成同源路径。
MEDIA_TUS_PUBLIC_ENDPOINT=/files
SWARM_TRACKER_PUBLIC_URL=/api/swarm/announce

# app 容器内部的数据与 sidecar 协作真相。
ATTACHMENT_STORAGE_DIR=/app/data/attachments
MEDIA_TUS_SERVER_PORT=1081
MEDIA_TUS_BASE_PATH=/files
MEDIA_TUS_UPLOAD_DIR=/app/data/tus
MEDIA_TUS_INTERNAL_BASE_URL=http://tusd:1081

# tracker / seeder 只走 Compose 内部网络，不暴露给浏览器。
SWARM_TRACKER_PORT=7072
SWARM_TRACKER_UPSTREAM_URL=ws://tracker:7072
SWARM_SEEDER_PORT=7073
SWARM_SEEDER_CONTROL_BASE_URL=http://seeder:7073
SWARM_SEEDER_TRACKER_URL=ws://app:8080/api/swarm/announce

# swarm 门禁与可选公开读路径。
SWARM_TICKET_SECRET=change-me
SWARM_WEB_SEED_PUBLIC_ENDPOINT=
SWARM_PEER_PRESENCE_STALE_SECONDS=180
